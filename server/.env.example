# Server port
PORT=5000

# Environment (development | production | test)
NODE_ENV=development

# Redis — required for room/game state
REDIS_URL=redis://localhost:6379

# PostgreSQL — leave blank to run without persistence (game still works)
DATABASE_URL=postgresql://user:password@localhost:5432/numwit

# Optional: Redis adapter for horizontal scaling across multiple server instances
# When set, @socket.io/redis-adapter is used automatically.
# REDIS_ADAPTER_URL=redis://localhost:6379

# CORS — origin(s) allowed to connect to the Socket.IO server.
# "*" is fine for local dev and for a single-origin production deployment
# (client served from client/dist by this same server — see server.js static
# serving + SPA fallback). If the client is ever hosted on a different origin
# (e.g. a separate static host), set this to that exact URL — wildcard "*"
# does not work with credentialed Socket.IO connections.
# CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=*

# Socket.IO heartbeat tuning (milliseconds)
SOCKET_PING_INTERVAL=20000
SOCKET_PING_TIMEOUT=10000

# Bot-fill — when a brand-new public room has fewer than MIN_PLAYERS real
# players after BOT_FILL_DELAY_MS, the server fills the rest with bots and
# starts the game. Set to "false" to disable this entirely (rooms will just
# keep waiting for real players).
BOT_FILL_ENABLED=true

# Admin dashboard — required to access /api/admin/* and the /admin page.
# HTTP Basic Auth: username "admin", password is this value. Leave unset to
# disable the admin interface entirely (returns 503).
# ADMIN_PASSWORD=change-me

# Neon direct (non-pooled) connection string — used only by the release step
# (server/scripts/release.sh) to run `prisma migrate deploy`. Falls back to
# DATABASE_URL when unset.
# DIRECT_URL=postgresql://user:password@direct-host/numwit?sslmode=require

# How long /api/stats results are cached (ms). The landing page polls it every
# 10s per visitor; caching keeps Redis commands flat. Default 10000.
# STATS_CACHE_MS=10000
