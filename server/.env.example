# Server port
PORT=5000

# Environment (development | production | test)
NODE_ENV=development

# Redis — required for room/game state
REDIS_URL=redis://localhost:6379

# PostgreSQL — leave blank to run without persistence (game still works)
DATABASE_URL=postgresql://user:password@localhost:5432/numwit

# Optional: Redis adapter for horizontal scaling across multiple server instances
# When set, @socket.io/redis-adapter is used automatically.
# REDIS_ADAPTER_URL=redis://localhost:6379

# CORS — origin(s) allowed to connect to the Socket.IO server.
# "*" is fine for local dev and for a single-origin production deployment
# (client served from client/dist by this same server — see server.js static
# serving + SPA fallback). If the client is ever hosted on a different origin
# (e.g. a separate static host), set this to that exact URL — wildcard "*"
# does not work with credentialed Socket.IO connections.
# CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=*

# Socket.IO heartbeat tuning (milliseconds)
SOCKET_PING_INTERVAL=5000
SOCKET_PING_TIMEOUT=3000
