// prisma/schema.prisma
// ─────────────────────────────────────────────────────────────────────────────
// Numwit — Platform data layer
// Run: npx prisma migrate dev --name init
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User ─────────────────────────────────────────────────────────────────────
// One row per device (identified by UUID stored in localStorage).
model User {
  id                  String   @id @default(uuid())
  deviceId            String   @unique
  name                String
  avatar              String
  xp                  Int      @default(0)
  level               Int      @default(1)
  consecutiveGameWins Int      @default(0)  // current win streak (reset to 0 on loss)
  bestStreak          Int      @default(0)  // highest consecutiveGameWins ever reached
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sessionStats     SessionStat[]
  userAchievements UserAchievement[]
  deviceAliases    DeviceAlias[]
}

// ── DeviceAlias ───────────────────────────────────────────────────────────────
// Extra browsers/devices that belong to a player. Created when the admin
// merges two players: the merged player's device keeps playing as the
// surviving one (see db/deviceAlias.js — every deviceId lookup resolves it).
model DeviceAlias {
  deviceId  String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── SessionStat ───────────────────────────────────────────────────────────────
// One row per completed game session.
model SessionStat {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rounds             Int      @default(0)
  wins               Int      @default(0)
  penalties          Int      @default(0)
  exactMatches       Int      @default(0)
  survived           Boolean  @default(false)  // true = last player standing
  // ── New achievement-tracking fields ──────────────────────────────────────
  roomType           String   @default("public")  // public | private | solo
  isDuel             Boolean  @default(false)      // exactly 2 human players
  playerCount        Int      @default(0)          // total players at game start (for Full House)
  maxConsecRoundWins Int      @default(0)          // longest round-win streak this session (On a Roll)
  wasLastPlace       Boolean  @default(false)      // was ever in last place (most penalties)
  playedAt           DateTime @default(now())

  @@index([userId])
  @@index([playedAt])
  @@index([isDuel, survived])   // for duel win queries
  @@index([roomType, survived]) // for solo win queries
}

// ── Achievement ───────────────────────────────────────────────────────────────
// Static catalogue seeded once.
model Achievement {
  id          String @id   // e.g. "first_win"
  name        String
  description String
  icon        String       // emoji

  userAchievements UserAchievement[]
}

// ── UserAchievement ───────────────────────────────────────────────────────────
// Junction — one row when a user unlocks an achievement.
model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

// ── Feedback ─────────────────────────────────────────────────────────────────
// User-submitted bug reports / feature requests / general feedback.
// Not tied via FK to User (deviceId may not have an associated User row yet,
// and feedback should persist even if the user record is later removed).
model Feedback {
  id        String   @id @default(uuid())
  deviceId  String?
  name      String?
  category  String   @default("other") // bug | feature | other
  message   String
  context   String?  // e.g. roomId or page the user was on
  userAgent String?
  status    String   @default("open")  // open | in_review | resolved
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// ── RoundLog ──────────────────────────────────────────────────────────────────
// One row per resolved round, for aggregate behaviour analysis ("what do
// humans actually pick?"). Deliberately anonymous: no user ids, names or
// socket ids — only an opaque per-game id so rounds of the same game can be
// grouped. Bot picks are excluded from humanPicks; average/target are the
// round's real values (which bots do influence — see humanCount/playerCount).
model RoundLog {
  id               String   @id @default(uuid())
  gameId           String               // random per game, not linked to players
  round            Int
  roomType         String               // public | private | solo
  playerCount      Int                  // active players this round (humans + bots)
  humanCount       Int
  humanPicks       Int[]                // submitted picks of human players only
  invalidCount     Int      @default(0) // picks voided by the duplicate rule
  average          Float?
  target           Float?
  targetMultiplier Float
  isVoid           Boolean  @default(false)
  exactMatch       Boolean  @default(false)
  isDuel           Boolean  @default(false)
  humanWon         Boolean  @default(false) // at least one human among the winners
  playedAt         DateTime @default(now())

  @@index([playedAt])
  @@index([gameId])
}
